# 复制本文件为 .env 后按需修改（服务启动时会自动读取，无需安装任何依赖）

# ---------- 服务 ----------
# 监听端口。若前面挂了 Nginx/Caddy 反代，建议只监听回环地址：HOST=127.0.0.1
PORT=8787
HOST=0.0.0.0

# 访问口令（可选，但公网部署强烈建议填）
# 填写后，前端需输入同一口令才能抽卡，防止他人盗用你的模型额度。
APP_TOKEN=

# 单篇文字上限（字符数）
MAX_INPUT_CHARS=60000

# 调用模型的超时时间（毫秒）
LLM_TIMEOUT_MS=180000

# ---------- 大模型 ----------
# 按 OpenAI 兼容协议接入，以下任选其一：

# DeepSeek（默认）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# 阿里云百炼 / 通义千问（兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 月之暗面 Kimi
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-32k

# 智谱 GLM
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-plus

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# 本地 Ollama（数据不出机器，不需要 API Key）
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=ollama

# 若模型服务支持 response_format=json_object，打开此项可显著降低解析失败率
# 已知支持：DeepSeek、OpenAI、阿里云百炼
LLM_JSON_MODE=0

# ---------- 演示模式 ----------
# 设为 1 时不调用模型，返回固定示例卡片。
# 用途：部署后先验证「网页 → 服务端 → 前端渲染」整条链路是否通畅。
DRY_RUN=0
